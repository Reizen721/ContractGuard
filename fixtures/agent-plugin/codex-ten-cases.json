        "openapi": "3.1.0",
        "info": {
          "title": "Identity API",
          "version": "1.0.0"
        },
        "paths": {
          "/profile": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "email"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "candidate": {
        "openapi": "3.1.0",
        "info": {
          "title": "Identity API",
          "version": "1.0.0"
        },
        "paths": {
          "/profile": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "CG-CODEX-07",
      "title": "异步导出成功响应被移除",
      "scenario": "POST /exports 原有 200 与 202 响应，候选删除 202。",
      "why": "现有客户端可能依赖 202 进入后台任务轮询；成功状态契约删除应提示迁移。",
      "expected": {
        "compatible": false,
        "ruleIds": [
          "RESPONSE_STATUS_REMOVED"
        ],
        "severities": [
          "breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 1,
          "potentiallyBreaking": 0,
          "nonBreaking": 0,
          "info": 0
        }
      },
      "baseline": {
        "openapi": "3.0.4",
        "info": {
          "title": "Export API",
          "version": "1.0.0"
        },
        "paths": {
          "/exports": {
            "post": {
              "responses": {
                "200": {
                  "description": "Success"
                },
                "202": {
                  "description": "Accepted for asynchronous export"
                }
              }
            }
          }
        }
      },
