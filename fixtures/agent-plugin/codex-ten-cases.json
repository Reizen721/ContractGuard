{
  "schemaVersion": 1,
  "suite": "ContractGuard V1.6 real Codex host acceptance",
  "description": "10 independently specified synthetic OpenAPI changes: 6 breaking, 1 potentially breaking, 3 non-breaking. Expected outcomes are native ContractGuard default-policy findings; host execution must be verified separately.",
  "cases": [
    {
      "id": "CG-CODEX-01",
      "title": "电商旧订单接口下线",
      "scenario": "删除 GET /legacy-orders 整条路径。",
      "why": "旧版移动端仍会请求此地址；路径消失后将无法取得订单，属于明确破坏。",
      "expected": {
        "compatible": false,
        "ruleIds": [
          "PATH_REMOVED"
        ],
        "severities": [
          "breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 1,
          "potentiallyBreaking": 0,
          "nonBreaking": 0,
          "info": 0
        }
      },
      "baseline": {
        "openapi": "3.0.4",
        "info": {
          "title": "Order API",
          "version": "1.0.0"
        },
        "paths": {
          "/legacy-orders": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success"
                }
              }
            }
          }
        }
      },
      "candidate": {
        "openapi": "3.0.4",
        "info": {
          "title": "Order API",
          "version": "1.0.0"
        },
        "paths": {}
      }
    },
    {
      "id": "CG-CODEX-02",
      "title": "多租户服务新增必填请求头",
      "scenario": "GET /invoices 新增必填 X-Tenant-Id 请求头。",
      "why": "旧客户端没有传租户头，原本合法的请求将不再满足契约。",
      "expected": {
        "compatible": false,
        "ruleIds": [
          "PARAMETER_ADDED_REQUIRED"
        ],
        "severities": [
          "breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 1,
          "potentiallyBreaking": 0,
          "nonBreaking": 0,
          "info": 0
        }
      },
      "baseline": {
        "openapi": "3.0.4",
        "info": {
          "title": "Billing API",
          "version": "1.0.0"
        },
        "paths": {
          "/invoices": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success"
                }
              }
            }
          }
        }
      },
      "candidate": {
        "openapi": "3.0.4",
        "info": {
          "title": "Billing API",
          "version": "1.0.0"
        },
        "paths": {
          "/invoices": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success"
                }
              },
              "parameters": [
                {
                  "name": "X-Tenant-Id",
                  "in": "header",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "CG-CODEX-03",
      "title": "支付方式枚举收窄",
      "scenario": "POST /payments 的 method 从 card、wallet 变为仅 card，使用 OpenAPI 3.1.0。",
      "why": "原本发送 wallet 的合法请求被排除，需要迁移对应调用方。",
      "expected": {
        "compatible": false,
        "ruleIds": [
          "SCHEMA_ENUM_NARROWED"
        ],
        "severities": [
          "breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 1,
          "potentiallyBreaking": 0,
          "nonBreaking": 0,
          "info": 0
        }
      },
      "baseline": {
        "openapi": "3.1.0",
        "info": {
          "title": "Payment API",
          "version": "1.0.0"
        },
        "paths": {
          "/payments": {
            "post": {
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string",
                          "enum": [
                            "card",
                            "wallet"
                          ]
                        }
                      },
                      "required": [
                        "method"
                      ]
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Success"
                }
              }
            }
          }
        }
      },
      "candidate": {
        "openapi": "3.1.0",
        "info": {
          "title": "Payment API",
          "version": "1.0.0"
        },
        "paths": {
          "/payments": {
            "post": {
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string",
                          "enum": [
                            "card"
                          ]
                        }
                      },
                      "required": [
                        "method"
                      ]
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Success"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "CG-CODEX-04",
      "title": "物流追踪编号类型改变",
      "scenario": "GET /shipment 的 trackingId 从 string 变为 integer。",
      "why": "客户端按字符串解析追踪编号，类型改变可能使反序列化失败，也可能丢失前导零。",
      "expected": {
        "compatible": false,
        "ruleIds": [
          "SCHEMA_TYPE_CHANGED"
        ],
        "severities": [
          "breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 1,
          "potentiallyBreaking": 0,
          "nonBreaking": 0,
          "info": 0
        }
      },
      "baseline": {
        "openapi": "3.0.4",
        "info": {
          "title": "Shipping API",
          "version": "1.0.0"
        },
        "paths": {
          "/shipment": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "trackingId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "trackingId"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "candidate": {
        "openapi": "3.0.4",
        "info": {
          "title": "Shipping API",
          "version": "1.0.0"
        },
        "paths": {
          "/shipment": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "trackingId": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "trackingId"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "CG-CODEX-05",
      "title": "任务状态增加新枚举值",
      "scenario": "GET /jobs 的 state 在 queued、running、done 之外增加 paused，使用 OpenAPI 3.1.0。",
      "why": "客户端穷举状态时可能遗漏 paused；本规则标为潜在破坏，compatible=true 仅表示没有 breaking，不能当作零风险。",
      "expected": {
        "compatible": true,
        "ruleIds": [
          "SCHEMA_ENUM_WIDENED"
        ],
        "severities": [
          "potentially-breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 0,
          "potentiallyBreaking": 1,
          "nonBreaking": 0,
          "info": 0
        }
      },
      "baseline": {
        "openapi": "3.1.0",
        "info": {
          "title": "Job API",
          "version": "1.0.0"
        },
        "paths": {
          "/jobs": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "enum": [
                              "queued",
                              "running",
                              "done"
                            ]
                          }
                        },
                        "required": [
                          "state"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "candidate": {
        "openapi": "3.1.0",
        "info": {
          "title": "Job API",
          "version": "1.0.0"
        },
        "paths": {
          "/jobs": {
            "get": {
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "enum": [
                              "queued",
                              "running",
                              "done",
                              "paused"
                            ]
                          }
                        },
                        "required": [
                          "state"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "CG-CODEX-06",
      "title": "用户响应不再保证 email 存在",
      "scenario": "GET /profile 保留 email 字段定义，但从 required 中移除，使用 OpenAPI 3.1.0。",
      "why": "字段并未删除，但旧客户端依赖它每次都有；新契约允许缺失，仍应识别为破坏。",
      "expected": {
        "compatible": false,
        "ruleIds": [
          "SCHEMA_REQUIRED_PROPERTY_REMOVED"
        ],
        "severities": [
          "breaking"
        ],
        "summary": {
          "total": 1,
          "breaking": 1,
          "potentiallyBreaking": 0,
          "nonBreaking": 0,
          "info": 0
        }
