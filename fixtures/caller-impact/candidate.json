{
  "openapi": "3.1.0",
  "info": { "title": "Caller migration example", "version": "2.0.0" },
  "paths": {
    "/orders/current": { "get": { "operationId": "getCurrentOrder", "responses": {
      "200": { "description": "Current order", "content": { "application/json": { "schema": {
        "type": "object", "required": ["id", "displayName"],
        "properties": { "id": { "type": "string" }, "displayName": { "type": "string" } }
      } } } }
    } } },
    "/profile": { "get": { "operationId": "getProfile", "responses": {
      "200": { "description": "Profile", "content": { "application/json": { "schema": {
        "type": "object", "required": ["contactEmail"], "properties": { "contactEmail": { "type": "string" } }
      } } } }
    } } }
  }
}
