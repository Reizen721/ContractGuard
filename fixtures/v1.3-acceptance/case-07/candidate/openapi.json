{
  "openapi": "3.1.0",
  "info": {
    "title": "ContractGuard acceptance 07",
    "version": "1"
  },
  "paths": {
    "/orders": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "paid",
                        "cancelled"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
