    "scenario": "两侧引用相同的未知 $schema 方言，候选将 string 改为 number；无法按已知方言作精确包含关系判断，只能报告潜在风险。",
    "baseline": {
      "entry": "openapi.json",
      "files": [
        "openapi.json",
        "schemas/value.json"
      ]
    },
