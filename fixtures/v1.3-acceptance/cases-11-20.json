  {
    "id": "case-15",
    "title": "Path Item 非冲突相邻 POST 删除",
    "scenario": "Path Item 引用本地文件中的 GET，同时在本体声明 POST；候选只删除相邻 POST，应检出操作删除，GET 继续保留。",
    "baseline": {
      "entry": "openapi.json",
      "files": [
        "openapi.json",
        "paths/orders.json"
      ]
    },
    "candidate": {
      "entry": "openapi.json",
      "files": [
        "openapi.json",
        "paths/orders.json"
      ]
    },
    "expect": {
      "compatible": false,
      "coverage": "complete",
      "findings": [
        {
          "ruleId": "OPERATION_REMOVED",
          "severity": "breaking"
        }
      ]
    }
  },
