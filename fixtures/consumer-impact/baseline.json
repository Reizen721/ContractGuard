{
  "openapi": "3.1.0",
  "info": { "title": "Retail Operations", "version": "1.0.0" },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["sku", "quantity"],
            "properties": { "sku": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 } }
          } } }
        },
        "responses": { "201": {
          "description": "Accepted order",
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["id", "status"],
            "properties": { "id": { "type": "string" }, "status": { "type": "string", "enum": ["accepted"] }, "receiptUrl": { "type": "string" } }
          } } }
        } }
      }
    },
    "/stats": {
      "get": { "operationId": "getStats", "responses": { "200": {
        "description": "Daily totals",
        "content": { "application/json": { "schema": {
          "type": "object", "required": ["revenue", "currency"],
          "properties": { "revenue": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "enum": ["USD"] } }
        } } }
      } } }
    },
    "/inventory": {
      "get": {
        "operationId": "getInventory",
        "parameters": [{ "name": "region", "in": "query", "required": true, "schema": { "type": "string", "enum": ["us", "eu"] } }],
        "responses": { "200": { "description": "Inventory page" } }
      }
    }
  }
}
