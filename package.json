{
  "name": "contractguard",
  "version": "2.0.0",
  "private": true,
  "description": "A local-first OpenAPI backward-compatibility analysis platform.",
  "keywords": [
    "openapi",
    "api-diff",
    "breaking-changes",
    "backward-compatibility",
    "api-governance",
    "contract-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reizen721/ContractGuard.git"
  },
  "bugs": {
    "url": "https://github.com/Reizen721/ContractGuard/issues"
  },
  "homepage": "https://github.com/Reizen721/ContractGuard#readme",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @contractguard/api dev\" \"pnpm --filter @contractguard/web dev\"",
    "start": "pnpm --filter @contractguard/api start",
    "pretest": "pnpm --filter @contractguard/api... build",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "docs:check": "node scripts/check-doc-links.mjs",
    "config:check": "node packages/core/scripts/check-config.mjs",
    "versions:check": "node scripts/check-release-version.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "regression": "node scripts/regression-test.mjs",
    "regression:v13": "node scripts/v13-regression.mjs",
    "regression:v14": "node scripts/regression-v14.mjs",
    "engine:install": "node scripts/install-oasdiff.mjs",
    "parity:oasdiff": "node scripts/oasdiff-parity.mjs",
    "regression:v15": "node scripts/regression-v15.mjs",
    "regression:v16": "node scripts/regression-v16.mjs",
    "regression:v17": "node scripts/regression-v17.mjs",
    "regression:v18": "node scripts/regression-v18.mjs",
    "regression:v20": "node scripts/regression-v20.mjs",
    "benchmark:v18": "node scripts/benchmark-v18.mjs",
    "benchmark:cegar": "node scripts/run-contractbench.mjs",
    "acceptance:v18:deepseek": "node scripts/acceptance-v18-deepseek.mjs",
    "mcp": "node packages/mcp/dist/index.js",
    "plugin:prepare": "node scripts/install-agent-plugin.mjs",
    "test:plugin": "node --test scripts/install-agent-plugin.test.mjs",
    "test:plugin:codex": "node scripts/test-agent-plugin-codex.mjs",
    "acceptance:v13": "node scripts/acceptance-v13.mjs",
    "scenarios:v13": "node scripts/scenarios-v13.mjs",
    "pretypecheck": "pnpm --filter @contractguard/api... build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm docs:check && pnpm config:check && pnpm versions:check && pnpm smoke && pnpm regression && pnpm regression:v13 && pnpm acceptance:v13 && pnpm scenarios:v13 && pnpm regression:v14 && pnpm parity:oasdiff && pnpm regression:v15 && pnpm regression:v16 && pnpm regression:v17 && pnpm regression:v18 && pnpm regression:v20 && pnpm test:plugin",
    "contractguard": "node apps/cli/dist/index.js",
    "demo": "node apps/cli/dist/index.js compare fixtures/petstore-v1.yaml fixtures/petstore-v2-breaking.yaml --fail-on never",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
