{
  "name": "@contractguard/cli",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "contractguard": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node .test-dist/formatters.test.js && node .test-dist/bundle-loader.test.js && node .test-dist/caller-files.test.js && node .test-dist/caller-command.test.js && node .test-dist/project-command.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@contractguard/core": "workspace:*",
    "@contractguard/caller": "workspace:*",
    "@contractguard/project": "workspace:*",
    "@contractguard/api": "workspace:*",
    "@contractguard/oasdiff": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
