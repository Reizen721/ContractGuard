{
  "name": "@contractguard/mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Standard MCP stdio tools for the local ContractGuard service.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": { ".": { "types": "./dist/server.d.ts", "import": "./dist/server.js" } },
  "bin": { "contractguard-mcp": "./dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.2", "zod": "4.6.7" },
  "devDependencies": { "@types/node": "^24.3.0", "esbuild": "0.28.2" },
  "engines": { "node": ">=22.13" }
}
